# ===================================================
# VisionIQ Environment Configuration Example
# Copy this file to .env and adjust variables as needed
# ===================================================

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=visioniq
MONGODB_TIMEOUT_MS=2000

# SQLite Fallback Configuration
DATABASE_URL=sqlite:///visioniq.db

# Video Analysis & Inference Parameters
CONFIDENCE_THRESHOLD=0.50
WINDOW_SEC=2.0
STRIDE_SEC=1.0
MAX_UPLOAD_SIZE_MB=500
