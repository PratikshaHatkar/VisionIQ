.installed.cfg
*.egg
.pytest_cache/
node_modules/
frontend/node_modules/
frontend/dist/

# 2. Virtual Environments & Anaconda
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
anaconda_projects/
conda/

# 3. Jupyter Notebook Checkpoints
.ipynb_checkpoints/
.virtual_documents/

# 4. Environment Variables & Secrets
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
secrets.json

# 5. Large Datasets, Uploaded Videos & Storage
DCSASS Dataset/
data/
dataset/
videos/
uploads/
storage/
*.mp4
*.avi
*.mov
*.mkv
*.flv
*.wmv
*.db
*.sqlite
*.sqlite3

