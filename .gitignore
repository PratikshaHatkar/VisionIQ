*.pth
*.pt
*.ckpt
*.bin
*.onnx
*.engine
*.h5
*.pb
checkpoints/*.pth
checkpoints/*.pt
checkpoints/*.ckpt

# 7. Logs & OS/IDE Temporary Files
*.log
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
